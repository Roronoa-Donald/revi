# ==============================================================================
# Configuration des variables d'environnement - Plateforme de cours & examens
# ==============================================================================

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cours_interactifs

# Sécurité & Sessions JWT
JWT_SECRET=votre-cle-secrete-jwt-tres-longue-et-aleatoire
NODE_ENV=development
PORT=3000

# Administration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe

# ------------------------------------------------------------------------------
# MOTEUR D'EXÉCUTION DE CODE DISTANT (PISTON)
# ------------------------------------------------------------------------------
# Pour les langages exécutés côté serveur (Bash, PowerShell, C, C++, Java, PHP, etc.)
# Définir l'URL de votre instance Piston (sur VPS ou hébergement privé).
# Exemples :
#   - VPS dédié / Docker Piston : http://votre-vps-ip:2000
#   - Domaine personnalisé : https://piston.votredomaine.com
#   - Instance emkc (si clé/whitelist) : https://emkc.org/api/v2/piston
PISTON_URL=https://piston.votredomaine.com

# Clé API optionnelle si votre instance Piston est protégée par un reverse-proxy
# PISTON_API_KEY=votre-token-secret-piston

# Timeout d'exécution en millisecondes (défaut : 20000ms = 20s)
CODE_EXEC_TIMEOUT_MS=20000

# Quotas d'exécution côté serveur (sécurité anti-abus)
EXEC_DAILY_LIMIT_PER_USER=40
EXEC_DAILY_LIMIT_GLOBAL=900

# ------------------------------------------------------------------------------
# TUTEUR IA (OPENROUTER) & SECTION PRÉPARATION
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
AI_HELP_MODEL=deepseek/deepseek-chat
PREPARATION_PASSWORD=
