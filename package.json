{
  "name": "cours-interactif-server",
  "version": "1.0.0",
  "description": "Serveur d'authentification avec clés d'activation pour cours interactifs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/smoke-code-lab.js",
    "labs:check": "node scripts/generate-code-labs.js --check",
    "courses": "node scripts/generate-courses.js",
    "courses:check": "node scripts/generate-courses.js --check",
    "vendor:monaco": "node scripts/vendor-monaco.js",
    "fix:auto-tracker": "node scripts/fix-auto-tracker.js",
    "audit:pages": "node corrections/outils/analyser-pages.js",
    "audit:sql": "bash corrections/outils/rejouer-isole.sh sql-audit",
    "audit:variantes-sql": "bash corrections/outils/rejouer-isole.sh sql-variantes",
    "audit:matrice-suspendus": "bash corrections/outils/sondes/matrice-suspendus/rejouer.sh",
    "audit:generalisation-sql": "bash corrections/outils/rejouer-isole.sh sql-generalisation",
    "audit:generalisation": "bash corrections/outils/audit-generalisation.sh",
    "audit:sql-b3-postgres": "python3 -I corrections/outils/sondes/sql-b3-postgresql/lancer.py .",
    "audit:langue": "node corrections/outils/verifier-langue.js",
    "audit:integrite": "bash corrections/outils/audit-integrite.sh",
    "audit:banque": "bash corrections/outils/rejouer-isole.sh banque",
    "audit:solutions": "bash corrections/outils/rejouer-isole.sh solutions",
    "audit:execution": "bash corrections/outils/rejouer-isole.sh execution",
    "audit:politique": "bash corrections/outils/rejouer-isole.sh politique"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@vercel/functions": "^3.6.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "acorn": "8.16.0",
    "dictionary-fr": "3.0.0",
    "parse5": "7.3.0",
    "playwright-core": "1.60.0"
  },
  "engines": {
    "node": "22.x"
  }
}
