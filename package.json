{
  "name": "cours-interactif-server",
  "version": "1.0.0",
  "description": "Serveur d'authentification avec clés d'activation pour cours interactifs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/smoke-code-lab.js",
    "labs:check": "node scripts/generate-code-labs.js --check",
    "courses": "node scripts/generate-courses.js",
    "courses:check": "node scripts/generate-courses.js --check",
    "vendor:monaco": "node scripts/vendor-monaco.js",
    "fix:auto-tracker": "node scripts/fix-auto-tracker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@vercel/functions": "^3.6.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
